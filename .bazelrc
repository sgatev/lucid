build --cxxopt=-std=c++26
build --host_cxxopt=-std=c++26
build --copt=-Werror
build --host_copt=-Werror

build:opt --cxxopt=-O3

build:release --stamp --workspace_status_command="scripts/workspace_status.sh"

build:asan --strip=never
build:asan --copt -fsanitize=address
build:asan --copt -O1
build:asan --copt -g
build:asan --copt -fno-omit-frame-pointer
build:asan --linkopt -fsanitize=address
build:asan --platform_suffix=asan

build:ubsan --strip=never
build:ubsan --copt -fsanitize=undefined
build:ubsan --copt -fno-omit-frame-pointer
build:ubsan --copt -fno-sanitize=function,vptr
build:ubsan --linkopt -fsanitize=undefined
build:ubsan --action_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
build:ubsan --platform_suffix=ubsan

# A coverage build is compiled in a sandbox whose path differs from action to
# action, and the sources it reports under that absolute path match none of
# those Bazel asked about, so their coverage is dropped. They are reported
# relative to the workspace instead.
coverage --combined_report=lcov
coverage --experimental_generate_llvm_lcov
coverage --copt=-ffile-compilation-dir=.
