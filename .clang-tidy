---
Checks: '
-*,
bugprone-*,
-bugprone-exception-escape,
-bugprone-easily-swappable-parameters,
performance-*,
modernize-use-emplace,
'
CheckOptions:
  # A positive literal is never the operand that goes wrong.
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
  # `value()` is how an optional that must hold a value is read: it checks.
  bugprone-unchecked-optional-access.IgnoreValueCalls: true
...
