fun printString(s: String): Int32 {
  return 0
}

fun rule(a: Int32, b: Int32, c: Int32): Int32 {
  if a == 1 {
    if b == 1 {
      if c == 1 {
        return 0
      } else {
        return 1
      }
    } else {
      if c == 1 {
        return 0
      } else {
        return 1
      }
    }
  } else {
    if b == 1 {
      if c == 1 {
        return 1
      } else {
        return 0
      }
    } else {
      if c == 1 {
        return 1
      } else {
        return 0
      }
    }
  }
}

fun main(): Int32 {
  mut val buffer: Int32[101]

  mut val col: Int32 = 0
  loop {
    if col == 101 {
      break
    }

    mut buffer[col] = 0

    mut col = col + 1
  }
  mut buffer[51] = 1

  mut val row: Int32 = 0
  loop {
    if row == 48 {
      break
    }

    mut val col: Int32 = 0
    loop {
      if col == 101 {
        break
      }

      if buffer[col] == 0 {
        do printString(" ")
      } else {
        do printString("*")
      }

      mut col = col + 1
    }
    do printString("\n")

    mut val prev: Int32 = buffer[0]
    mut col = 1
    loop {
      if col == 100 {
        break
      }

      val new: Int32 = rule(prev, buffer[col], buffer[col+1])
      mut prev = buffer[col]
      mut buffer[col] = new

      mut col = col + 1
    }

    mut row = row + 1
  }

  return 0
}
