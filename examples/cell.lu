let main = () -> Int32 {
  let a: Int32[101] = 0
  let b: Int32[101] = 0

  let j: Int32 = 0
  loop {
    if j == 101 {
      break
    }

    a[j] = 0
    b[j] = 0

    j = j + 1
  }


  a[51] = 1

  j = 0
  loop {
    if j == 48 {
      break
    }

    let i: Int32 = 0
    loop {
      if i == 101 {
        break
      }

      let r: Int32 = a[i]
      if r == 0 {
        printf("  ")
      } else {
        printf("██")
      }

      i = i + 1
    }
    printf("\n")

    i = 1
    loop {
      if i == 100 {
        break
      }

      if a[i-1] == 1 {
        if a[i] == 1 {
          if a[i+1] == 1 {
            b[i] = 0
          } else {
            b[i] = 1
          }
        } else {
          if a[i+1] == 1 {
            b[i] = 0
          } else {
            b[i] = 1
          }
        }
      } else {
        if a[i] == 1 {
          if a[i+1] == 1 {
            b[i] = 1
          } else {
            b[i] = 0
          }
        } else {
          if a[i+1] == 1 {
            b[i] = 1
          } else {
            b[i] = 0
          }
        }
      }

      i = i + 1
    }

    i = 0
    loop {
      if i == 101 {
        break
      }

      a[i] = b[i]
      b[i] = 0

      i = i + 1
    }

    j = j + 1
  }

  return 0
}
