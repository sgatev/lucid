let printf = (n: String) -> Int32 {
  return 0
}

let main = () -> Int32 {
  let a: Int32[10] = 0
  let b: Int32[10] = 0

  a[5] = 1

  let j: Int32 = 0
  loop {
    if j == 10 {
      break
    }

    let i: Int32 = 0
    loop {
      if i == 10 {
        break
      }

      let r: Int32 = a[i]
      if r == 0 {
        printf(" ")
      } else {
        printf("█")
      }

      i = i + 1
    }
    printf("\n")

    i = 1
    loop {
      if i == 9 {
        break
      }

      let ap: Int32 = a[i-1]
      let ac: Int32 = a[i]
      let an: Int32 = a[i+1]

      if ap == 1 {
        if ac == 1 {
          if an == 1 {
            b[i] = 0
          } else {
            b[i] = 1
          }
        } else {
          if an == 1 {
            b[i] = 0
          } else {
            b[i] = 1
          }
        }
      } else {
        if ac == 1 {
          if an == 1 {
            b[i] = 1
          } else {
            b[i] = 0
          }
        } else {
          if an == 1 {
            b[i] = 1
          } else {
            b[i] = 0
          }
        }
      }

      i = i + 1
    }

    i = 0
    loop {
      if i == 10 {
        break
      }

      let r: Int32 = b[i]
      a[i] = r
      b[i] = 0

      i = i + 1
    }

    j = j + 1
  }

  return 0
}
