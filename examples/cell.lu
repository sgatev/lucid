let printf = (n: String) -> Int32 {
  return 0
}

let rule = (a: Int32, b: Int32, c: Int32) -> Int32 {
  if a == 1 {
    if b == 1 {
      if c == 1 {
        return 0
      } else {
        return 1
      }
    } else {
      if c == 1 {
        return 0
      } else {
        return 1
      }
    }
  } else {
    if b == 1 {
      if c == 1 {
        return 1
      } else {
        return 0
      }
    } else {
      if c == 1 {
        return 1
      } else {
        return 0
      }
    }
  }
}

let main = () -> Int32 {
  let buffer: Int32[101] = 0

  let col: Int32 = 0
  loop {
    if col == 101 {
      break
    }

    buffer[col] = 0

    col = col + 1
  }
  buffer[51] = 1

  let row: Int32 = 0
  loop {
    if row == 48 {
      break
    }

    let col: Int32 = 0
    loop {
      if col == 101 {
        break
      }

      if buffer[col] == 0 {
        do printf("  ")
      } else {
        do printf("██")
      }

      col = col + 1
    }
    do printf("\n")

    let prev: Int32 = buffer[0]
    col = 1
    loop {
      if col == 100 {
        break
      }

      let new: Int32 = rule(prev, buffer[col], buffer[col+1])
      prev = buffer[col]
      buffer[col] = new

      col = col + 1
    }

    row = row + 1
  }

  return 0
}
