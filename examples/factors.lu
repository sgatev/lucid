let printf = (f: String, n: Int32) -> Int32 {
  return 0
}

let factors = (n: Int32) -> Int32 {
  let i: Int32 = 2
  loop {
    if i == n {
      break
    }

    if n % i == 0 {
      do printf("%d\n", i)
    }
    
    i = i + 1
  }
  return 0
}

let main = () -> Int32 {
  do factors(42)
  return 0
}
