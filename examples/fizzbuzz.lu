let printf = (n: String, m: Int32) -> Int32 {
  return 0
}

let main = () -> Int32 {
  let n: Int32 = 1
  loop {
    if n > 30 {
      break
    }

    if n % 15 == 0 {
      printf("fizzbuzz\n", 0)
    } else if n % 3 == 0 {
      printf("fizz\n", 0)
    } else if n % 5 == 0 {
      printf("buzz\n", 0)
    } else {
      printf("%d\n", n)
    }

    n = n + 1
  }
  return 0
}
