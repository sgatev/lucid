fun printString(s: String): Int32 {
  return 0
}

fun sleep(n: Int32): Int32 {
  return 0
}

fun main(): Int32 {
  mut val current: Int32[200]
  mut val next: Int32[200]

  mut val i: Int32 = 0
  loop {
    if i == 10 {
      break
    }

    mut val j: Int32 = 0
    loop {
      if j == 20 {
        break
      }

      val y: Int32 = i * 20
      mut current[y + j] = 0

      mut j = j + 1
    }

    mut i = i + 1
  }

  mut current[21] = 1
  mut current[42] = 1
  mut current[43] = 1
  mut current[61] = 1
  mut current[62] = 1

  mut val f: Int32 = 0
  loop {
    if f == 29 {
      break
    }

    do printString("\33c")

    mut i = 0 
    loop {
      if i == 10 {
        break
      }

      mut val j: Int32 = 0
      loop {
        if j == 20 {
          break
        }

        val y: Int32 = i * 20
        if current[y + j] == 1 {
          do printString("██")
        } else {
          do printString("  ")
        }

        mut j = j + 1
      }
      do printString("\n")

      mut i = i + 1
    }

    mut i = 0 
    loop {
      if i == 10 {
        break
      }

      mut val j: Int32 = 0
      loop {
        if j == 20 {
          break
        }

        val y: Int32 = i * 20
        val z: Int32 = y + j

        mut val neighbours: Int32 = 0
        if i > 0 {
          if j < 19 {
            mut neighbours = neighbours + current[z - 19]
          }
          mut neighbours = neighbours + current[z - 20]
          if j > 0 {
            mut neighbours = neighbours + current[z - 21]
          }
        }
        if j > 0 {
          mut neighbours = neighbours + current[z - 1]
        }
        if i < 9 {
          if j > 0 {
            mut neighbours = neighbours + current[z + 19]
          }
          mut neighbours = neighbours + current[z + 20]
          if j < 19 {
            mut neighbours = neighbours + current[z + 21]
          }
        }
        if j < 19 {
          mut neighbours = neighbours + current[z + 1]
        }

        if neighbours < 2 {
          mut next[z] = 0
        } else if neighbours == 2 {
          mut next[z] = current[z]
        } else if neighbours == 3 {
          mut next[z] = 1
        } else if neighbours > 3 {
          mut next[z] = 0
        }

        mut j = j + 1
      }

      mut i = i + 1
    }

    mut i = 0
    loop {
      if i == 10 {
        break
      }

      mut val j: Int32 = 0
      loop {
        if j == 20 {
          break
        }

        val y: Int32 = i * 20
        mut current[y + j] = next[y + j]

        mut j = j + 1
      }

      mut i = i + 1
    }

    do sleep(1)

    mut f = f + 1
  }

  return 0
}
