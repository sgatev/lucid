let printString = (s: String, n: Int64) -> Int32 {
  return 0
}

let sleep = (n: Int32) -> Int32 {
  return 0
}

let main = () -> Int32 {
  let current: Int32[200] = 0
  let next: Int32[200] = 0

  let i: Int32 = 0
  loop {
    if i == 10 {
      break
    }

    let j: Int32 = 0
    loop {
      if j == 20 {
        break
      }

      let y: Int32 = i * 20
      current[y + j] = 0

      j = j + 1
    }

    i = i + 1
  }

  current[21] = 1
  current[42] = 1
  current[43] = 1
  current[61] = 1
  current[62] = 1

  let f: Int32 = 0
  loop {
    if f == 29 {
      break
    }

    do printString("\33c", 3)

    i = 0 
    loop {
      if i == 10 {
        break
      }

      let j: Int32 = 0
      loop {
        if j == 20 {
          break
        }

        let y: Int32 = i * 20
        if current[y + j] == 1 {
          do printString("*", 1)
        } else {
          do printString(" ", 1)
        }

        j = j + 1
      }
      do printString("\n", 1)

      i = i + 1
    }

    i = 0 
    loop {
      if i == 10 {
        break
      }

      let j: Int32 = 0
      loop {
        if j == 20 {
          break
        }

        let y: Int32 = i * 20
        let z: Int32 = y + j

        let neighbours: Int32 = 0
        if i > 0 {
          if j < 19 {
            neighbours = neighbours + current[z - 19]
          }
          neighbours = neighbours + current[z - 20]
          if j > 0 {
            neighbours = neighbours + current[z - 21]
          }
        }
        if j > 0 {
          neighbours = neighbours + current[z - 1]
        }
        if i < 9 {
          if j > 0 {
            neighbours = neighbours + current[z + 19]
          }
          neighbours = neighbours + current[z + 20]
          if j < 19 {
            neighbours = neighbours + current[z + 21]
          }
        }
        if j < 19 {
          neighbours = neighbours + current[z + 1]
        }

        if neighbours < 2 {
          next[z] = 0
        } else if neighbours == 2 {
          next[z] = current[z]
        } else if neighbours == 3 {
          next[z] = 1
        } else if neighbours > 3 {
          next[z] = 0
        }

        j = j + 1
      }

      i = i + 1
    }

    i = 0
    loop {
      if i == 10 {
        break
      }

      let j: Int32 = 0
      loop {
        if j == 20 {
          break
        }

        let y: Int32 = i * 20
        current[y + j] = next[y + j]

        j = j + 1
      }

      i = i + 1
    }

    do sleep(1)

    f = f + 1
  }

  return 0
}
