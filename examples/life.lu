fun printString(s: String): Int32 {
  return 0
}

fun sleep(n: Int32): Int32 {
  return 0
}

fun main(): Int32 {
  val current: Int32[200]
  val next: Int32[200]

  val i: Int32 = 0
  loop {
    if i == 10 {
      break
    }

    val j: Int32 = 0
    loop {
      if j == 20 {
        break
      }

      val y: Int32 = i * 20
      &current[y + j] = 0

      &j = j + 1
    }

    &i = i + 1
  }

  &current[21] = 1
  &current[42] = 1
  &current[43] = 1
  &current[61] = 1
  &current[62] = 1

  val f: Int32 = 0
  loop {
    if f == 29 {
      break
    }

    do printString("\33c")

    &i = 0 
    loop {
      if i == 10 {
        break
      }

      val j: Int32 = 0
      loop {
        if j == 20 {
          break
        }

        val y: Int32 = i * 20
        if current[y + j] == 1 {
          do printString("██")
        } else {
          do printString("  ")
        }

        &j = j + 1
      }
      do printString("\n")

      &i = i + 1
    }

    &i = 0 
    loop {
      if i == 10 {
        break
      }

      val j: Int32 = 0
      loop {
        if j == 20 {
          break
        }

        val y: Int32 = i * 20
        val z: Int32 = y + j

        val neighbours: Int32 = 0
        if i > 0 {
          if j < 19 {
            &neighbours = neighbours + current[z - 19]
          }
          &neighbours = neighbours + current[z - 20]
          if j > 0 {
            &neighbours = neighbours + current[z - 21]
          }
        }
        if j > 0 {
          &neighbours = neighbours + current[z - 1]
        }
        if i < 9 {
          if j > 0 {
            &neighbours = neighbours + current[z + 19]
          }
          &neighbours = neighbours + current[z + 20]
          if j < 19 {
            &neighbours = neighbours + current[z + 21]
          }
        }
        if j < 19 {
          &neighbours = neighbours + current[z + 1]
        }

        if neighbours < 2 {
          &next[z] = 0
        } else if neighbours == 2 {
          &next[z] = current[z]
        } else if neighbours == 3 {
          &next[z] = 1
        } else if neighbours > 3 {
          &next[z] = 0
        }

        &j = j + 1
      }

      &i = i + 1
    }

    &i = 0
    loop {
      if i == 10 {
        break
      }

      val j: Int32 = 0
      loop {
        if j == 20 {
          break
        }

        val y: Int32 = i * 20
        &current[y + j] = next[y + j]

        &j = j + 1
      }

      &i = i + 1
    }

    do sleep(1)

    &f = f + 1
  }

  return 0
}
