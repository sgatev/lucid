    name = "version",
    hdrs = ["version.h"],
)

genrule(
    name = "version_gen",
    srcs = ["version.h.tmpl"],
    outs = ["version.h"],
    cmd_bash = """
      commit=$$(grep ^STABLE_GIT_COMMIT bazel-out/stable-status.txt | cut -d ' ' -f2 ||
                echo "unstamped"); \
      sed -e 's/%GIT_COMMIT%/'$$commit'/' < $< > $@
    """,
    stamp = 1,
)
