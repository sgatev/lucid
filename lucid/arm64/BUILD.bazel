load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "assembler",
    hdrs = ["assembler.h"],
    visibility = ["//lucid:__subpackages__"],
    deps = [
        "//lucid/core/container:hash_map",
        "//lucid/core/numeric:bits",
        "//lucid/core/string:encoding",
    ],
)

cc_test(
    name = "assembler_test",
    srcs = ["assembler_test.cc"],
    deps = [
        ":assembler",
        "//lucid/core/testing",
    ],
)

cc_library(
    name = "macho",
    srcs = ["macho.cc"],
    hdrs = ["macho.h"],
    visibility = ["//lucid:__subpackages__"],
    deps = [
        ":assembler",
    ],
)

cc_test(
    name = "macho_test",
    srcs = ["macho_test.cc"],
    # The object is read back with the system's own Mach-O definitions, which
    # only a macOS host has. Nothing here runs the code it assembles, so the
    # host's architecture does not matter.
    target_compatible_with = [
        "@platforms//os:macos",
    ],
    deps = [
        ":assembler",
        ":macho",
        "//lucid/core/testing",
    ],
)

cc_library(
    name = "translator",
    srcs = ["translator.cc"],
    hdrs = ["translator.h"],
    visibility = ["//lucid:__subpackages__"],
    deps = [
        ":assembler",
        "//lucid/am:cfg",
        "//lucid/am:instructions",
        "//lucid/am:state",
        "//lucid/core/container:hash_map",
        "//lucid/core/container:hash_set",
        "//lucid/core/container/graph:order",
        "//lucid/core/string:index",
        "//lucid/syntax:ast",
        "//lucid/syntax:context",
    ],
)

cc_test(
    name = "translator_test",
    srcs = ["translator_test.cc"],
    deps = [
        ":assembler",
        ":translator",
        "//lucid/am:cfg_builder",
        "//lucid/am:instructions",
        "//lucid/am:state",
        "//lucid/core/testing",
        "//lucid/syntax:context",
    ],
)
