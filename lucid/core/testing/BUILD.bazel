load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(
    default_testonly = True,
)

cc_library(
    name = "testing_library",
    srcs = ["testing.cc"],
    hdrs = ["testing.h"],
    visibility = ["//lucid:__subpackages__"],
    deps = [
        "//lucid/core/string:concat",
        "//lucid/core/testing/internal:all_matcher",
        "//lucid/core/testing/internal:boolean_matcher",
        "//lucid/core/testing/internal:elements_matcher",
        "//lucid/core/testing/internal:empty_matcher",
        "//lucid/core/testing/internal:equality_matcher",
        "//lucid/core/testing/internal:field_matcher",
        "//lucid/core/testing/internal:matcher",
        "//lucid/core/testing/internal:not_matcher",
        "//lucid/core/testing/internal:optional_matcher",
        "//lucid/core/testing/internal:pair_matcher",
        "//lucid/core/testing/internal:predicate_matcher",
        "//lucid/core/testing/internal:prefix_matcher",
        "//lucid/core/testing/internal:size_matcher",
        "//lucid/core/testing/internal:suffix_matcher",
        "//lucid/core/testing/internal:unordered_elements_matcher",
        "//lucid/core/testing/internal:variant_matcher",
    ],
    alwayslink = True,
)

cc_library(
    name = "testing",
    srcs = ["testing_main.cc"],
    hdrs = ["testing.h"],
    visibility = ["//lucid:__subpackages__"],
    deps = [
        ":testing_library",
        "//lucid/core/cli",
        "//lucid/core/string:concat",
        "//lucid/core/testing/internal:all_matcher",
        "//lucid/core/testing/internal:boolean_matcher",
        "//lucid/core/testing/internal:elements_matcher",
        "//lucid/core/testing/internal:empty_matcher",
        "//lucid/core/testing/internal:equality_matcher",
        "//lucid/core/testing/internal:field_matcher",
        "//lucid/core/testing/internal:matcher",
        "//lucid/core/testing/internal:not_matcher",
        "//lucid/core/testing/internal:optional_matcher",
        "//lucid/core/testing/internal:pair_matcher",
        "//lucid/core/testing/internal:predicate_matcher",
        "//lucid/core/testing/internal:prefix_matcher",
        "//lucid/core/testing/internal:size_matcher",
        "//lucid/core/testing/internal:suffix_matcher",
        "//lucid/core/testing/internal:unordered_elements_matcher",
        "//lucid/core/testing/internal:variant_matcher",
    ],
    alwayslink = True,
)

genrule(
    name = "run_passing_tests",
    outs = ["passing_tests_output"],
    cmd = "$(location //lucid/core/testing/testdata:passing_tests) --disable_timings > $@",
    tools = ["//lucid/core/testing/testdata:passing_tests"],
)

diff_test(
    name = "passing_tests_test",
    file1 = "//lucid/core/testing/testdata:expected_passing_tests_output",
    file2 = ":passing_tests_output",
)

genrule(
    name = "run_timed_tests",
    outs = ["timed_tests_output"],
    # Durations vary from run to run, so they are replaced with a placeholder. What is
    # being pinned is that they are printed, and where.
    cmd = "$(location //lucid/core/testing/testdata:passing_tests) --filter=Boolean | sed -E 's/[(][0-9]+[^)]*[)]/(<duration>)/g' > $@",
    tools = ["//lucid/core/testing/testdata:passing_tests"],
)

diff_test(
    name = "timed_tests_test",
    file1 = "//lucid/core/testing/testdata:expected_timed_tests_output",
    file2 = ":timed_tests_output",
)

genrule(
    name = "run_filtered_tests",
    outs = ["filtered_tests_output"],
    cmd = "$(location //lucid/core/testing/testdata:passing_tests) --disable_timings --filter=Unordered > $@",
    tools = ["//lucid/core/testing/testdata:passing_tests"],
)

diff_test(
    name = "filtered_tests_test",
    file1 = "//lucid/core/testing/testdata:expected_filtered_tests_output",
    file2 = ":filtered_tests_output",
)

genrule(
    name = "run_unmatched_filter_tests",
    outs = ["unmatched_filter_tests_output"],
    cmd = """
    if $(location //lucid/core/testing/testdata:passing_tests) --disable_timings --filter=NoSuchTest > $@ 2>&1; then
      echo "ERROR: Expected tool to fail, but it exited with 0" >&2
      exit 1
    fi
    """,
    tools = ["//lucid/core/testing/testdata:passing_tests"],
)

diff_test(
    name = "unmatched_filter_tests_test",
    file1 = "//lucid/core/testing/testdata:expected_unmatched_filter_tests_output",
    file2 = ":unmatched_filter_tests_output",
)

genrule(
    name = "run_failing_tests",
    outs = ["failing_tests_output"],
    cmd = """
    if $(location //lucid/core/testing/testdata:failing_tests) --disable_timings > $@ 2>&1; then
      echo "ERROR: Expected tool to fail, but it exited with 0" >&2
      exit 1
    fi
    """,
    tools = ["//lucid/core/testing/testdata:failing_tests"],
)

diff_test(
    name = "failing_tests_test",
    file1 = "//lucid/core/testing/testdata:expected_failing_tests_output",
    file2 = ":failing_tests_output",
)
